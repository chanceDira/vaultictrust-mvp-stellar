# Stellar network: testnet | mainnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional RPC overrides (defaults come from scaffold.config.ts)
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Optional. Public WalletConnect project id. When set, mobile wallets appear in the connect list.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only - never prefix with NEXT_PUBLIC_
PINATA_JWT=

# Optional availability copy. When these are empty, listings still use the chain and IPFS.
# Never prefix the service role key with NEXT_PUBLIC_.
# Apply packages/nextjs/supabase/migrations/0001_listing_copy.sql in the Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CLI only: packages/nextjs/scripts/manage-admins.ts
# ADMIN_SECRET=
