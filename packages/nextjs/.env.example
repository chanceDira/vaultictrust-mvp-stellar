# Stellar network: testnet | mainnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional RPC overrides (defaults come from scaffold.config.ts)
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Optional. Public WalletConnect project id. When set, mobile wallets appear in the connect list.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only - never prefix with NEXT_PUBLIC_
PINATA_JWT=

# CLI only: packages/nextjs/scripts/manage-admins.ts
# ADMIN_SECRET=
